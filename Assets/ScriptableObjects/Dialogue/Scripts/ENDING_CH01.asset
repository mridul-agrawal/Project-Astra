  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f5916365cbfdcb549a23fd2a12e57125, type: 3}
  m_Name: ENDING_CH01
  m_EditorClassIdentifier: ProjectAstra.Core::ProjectAstra.Core.Dialogue.DialogueScript
  scriptId: ENDING_CH01
  segments:
  - _background: {fileID: 0}
    textSpeed: -1
    autoAdvanceDelay: 0
    lines:
    - _speakerId: NARRATOR
      expression: 0
      portraitPosition: 3
      portraitFacing: 0
      text: Dusk. The last of them slips back across the water. The bridge holds.
    - _speakerId: CHILD
      expression: 6
      portraitPosition: 1
      portraitFacing: 0
      text: Are they coming back? When it's dark?
    - _speakerId: PROTAGONIST
      expression: 0
      portraitPosition: 0
      portraitFacing: 1
      text: Not tonight. They don't move blind any better than we do.
    - _speakerId: CHILD
      expression: 0
      portraitPosition: 1
      portraitFacing: 0
      text: You're bleeding. On your arm.
    - _speakerId: PROTAGONIST
      expression: 0
      portraitPosition: 0
      portraitFacing: 1
      text: It'll keep. I've stitched worse, hunting.
    - _speakerId: NARRATOR
      expression: 0
      portraitPosition: 3
      portraitFacing: 0
      text: The child looks back toward the houses. Aranya puts a hand on their shoulder
        and turns them north.
    - _speakerId: PROTAGONIST
      expression: 0
      portraitPosition: 0
      portraitFacing: 1
      text: That was too few of them. The rest went on ahead.
    - _speakerId: PROTAGONIST
      expression: 5
      portraitPosition: 0
      portraitFacing: 1
      text: Gajen's still up the mountain. Holding it alone.
  nodes: []
