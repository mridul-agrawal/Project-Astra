  m_Name: MAP1_BOSS_TAUNT
  m_EditorClassIdentifier: ProjectAstra.Core::ProjectAstra.Core.Dialogue.DialogueScript
  _scriptId: MAP1_BOSS_TAUNT
  _segments:
  - _background: {fileID: 0}
    _textSpeed: -1
    _autoAdvanceDelay: 0
    _lines:
    - _speakerId: RAKSHASA_CHIEF
      _expression: 0
      _portraitPosition: 0
      _portraitFacing: 1
      _text: Come, little archer. Your bridge wont hold us for long.
    - _speakerId: PROTAGONIST
      _expression: 5
      _portraitPosition: 1
      _portraitFacing: 0
      _text: "This village  is not yours to take. \nNot while I draw breath."
  _nodes:
  - _nodeId: 0
    _speakerId: RAKSHASA_CHIEF
    _expression: 0
    _portraitPosition: 1
    _portraitFacing: 1
    _text: So the whelp has teeth. Come, little archer. Your bridge bought them a
      night. Nothing buys them a dawn.
    _textSpeedOverride: -1
    _autoAdvanceDelay: 0
    _fullScreenImage: {fileID: 0}
  - _nodeId: 1
    _speakerId: PROTAGONIST
    _expression: 5
    _portraitPosition: 0
    _portraitFacing: 0
    _text: Suvarnapur is not yours to take. Not while I draw breath.
    _textSpeedOverride: -1
    _autoAdvanceDelay: 0
    _fullScreenImage: {fileID: 0}
