  m_Script: {fileID: 11500000, guid: f5916365cbfdcb549a23fd2a12e57125, type: 3}
  m_Name: MAP1_BOSS_TAUNT
  m_EditorClassIdentifier: ProjectAstra.Core::ProjectAstra.Core.Dialogue.DialogueScript
  scriptId: MAP1_BOSS_TAUNT
  segments:
  - _background: {fileID: 0}
    textSpeed: -1
    autoAdvanceDelay: 0
    lines:
    - _speakerId: RAKSHASA_CHIEF
      expression: 0
      portraitPosition: 0
      portraitFacing: 1
      text: Come, little archer. Your bridge wont hold us for long.
    - _speakerId: PROTAGONIST
      expression: 5
      portraitPosition: 1
      portraitFacing: 0
      text: "This village  is not yours to take. \nNot while I draw breath."
  nodes:
  - _nodeId: 0
    speakerId: RAKSHASA_CHIEF
    expression: 0
    portraitPosition: 1
    portraitFacing: 1
    text: So the whelp has teeth. Come, little archer. Your bridge bought them a
      night. Nothing buys them a dawn.
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 0}
  - _nodeId: 1
    speakerId: PROTAGONIST
    expression: 5
    portraitPosition: 0
    portraitFacing: 0
    text: Suvarnapur is not yours to take. Not while I draw breath.
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 0}
