%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f5916365cbfdcb549a23fd2a12e57125, type: 3}
  m_Name: OPENING_CH01.backup
  m_EditorClassIdentifier: ProjectAstra.Core::ProjectAstra.Core.Dialogue.DialogueScript
  scriptId: OPENING_CH01
  nodes:
  - nodeId: 0
    speakerId: NARRATOR
    expression: 0
    portraitPosition: 3
    portraitFacing: 0
    text: "Below the mountains, \nwhere the jungle keeps its oldest secrets,"
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 5555fa21db147a64dbd0485685737c58, type: 3}
  - nodeId: 1
    speakerId: NARRATOR
    expression: 0
    portraitPosition: 3
    portraitFacing: 0
    text: 'there was a village that asked little of the world.

'
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 5555fa21db147a64dbd0485685737c58, type: 3}
  - nodeId: 2
    speakerId: NARRATOR
    expression: 0
    portraitPosition: 3
    portraitFacing: 0
    text: "And a girl who hunted its forests. \n"
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 5555fa21db147a64dbd0485685737c58, type: 3}
  - nodeId: 3
    speakerId: NARRATOR
    expression: 0
    portraitPosition: 3
    portraitFacing: 0
    text: "She could read a trail like scripture, \nand loose an arrow before a
      deer thought to run."
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 5555fa21db147a64dbd0485685737c58, type: 3}
  - nodeId: 4
    speakerId: NARRATOR
    expression: 0
    portraitPosition: 3
    portraitFacing: 0
    text: 'This dusk, she tracked alone,

      the way she liked best.'
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 5555fa21db147a64dbd0485685737c58, type: 3}
  - nodeId: 5
    speakerId: PROTAGONIST
    expression: 0
    portraitPosition: 0
    portraitFacing: 1
    text: 'Fresh tracks. Still soft at the edges.

'
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 7776573a2e3d9574b992d6c915af533c, type: 3}
  - nodeId: 6
    speakerId: PROTAGONIST
    expression: 0
    portraitPosition: 0
    portraitFacing: 1
    text: "But these aren't deer. \nNot boar. \u2026Nothing I've ever tracked."
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 7776573a2e3d9574b992d6c915af533c, type: 3}
  - nodeId: 7
    speakerId: PROTAGONIST
    expression: 4
    portraitPosition: 0
    portraitFacing: 1
    text: "Too deep...  Clawed... \nAnd they don't wander like a beast."
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 7776573a2e3d9574b992d6c915af533c, type: 3}
  - nodeId: 8
    speakerId: PROTAGONIST
    expression: 4
    portraitPosition: 0
    portraitFacing: 1
    text: "They go straight...\n\u2026Straight for the village!"
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 7776573a2e3d9574b992d6c915af533c, type: 3}
  - nodeId: 9
    speakerId: PROTAGONIST
    expression: 0
    portraitPosition: 0
    portraitFacing: 1
    text: "There is smoke in the sky too\u2026. \r\nWait! Its coming from the same
      direction!"
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 7776573a2e3d9574b992d6c915af533c, type: 3}
  - nodeId: 10
    speakerId: PROTAGONIST
    expression: 0
    portraitPosition: 0
    portraitFacing: 1
    text: "From the Village\u2026 from Home!\r\nI must return quickly!"
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 7776573a2e3d9574b992d6c915af533c, type: 3}
  - nodeId: 11
    speakerId: CHILD
    expression: 0
    portraitPosition: 0
    portraitFacing: 1
    text: "Aranya! Aranya\u2014!\n"
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
  - nodeId: 12
    speakerId: PROTAGONIST
    expression: 0
    portraitPosition: 1
    portraitFacing: 0
    text: "- I'm here\u2026 Breathe.\r\n- Look at me\u2026 what happened?"
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
  - nodeId: 13
    speakerId: PROTAGONIST
    expression: 0
    portraitPosition: 1
    portraitFacing: 0
    text: "I'm here\u2026 Breathe.\rLook at me\u2026 what happened?"
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
  - nodeId: 14
    speakerId: CHILD
    expression: 0
    portraitPosition: 0
    portraitFacing: 1
    text: "They came out of the dark. \r\nMonsters\u2026 Rakshas."
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
  - nodeId: 15
    speakerId: CHILD
    expression: 0
    portraitPosition: 0
    portraitFacing: 1
    text: "They burned the granary! \r\nand Maa told me to run and not look back"
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
  - nodeId: 16
    speakerId: PROTAGONIST
    expression: 0
    portraitPosition: 1
    portraitFacing: 0
    text: "You did right to run. \nWhere are the others?"
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
  - nodeId: 17
    speakerId: CHILD
    expression: 0
    portraitPosition: 0
    portraitFacing: 1
    text: 'Others are Hiding.

      The Rakshas are attacking the temple too.'
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
  - nodeId: 18
    speakerId: PROTAGONIST
    expression: 0
    portraitPosition: 1
    portraitFacing: 0
    text: "The temple\u2026\r\nGajen, the gatekeeper\u2026 where is he?"
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
  - nodeId: 19
    speakerId: CHILD
    expression: 0
    portraitPosition: 0
    portraitFacing: 1
    text: "At the temple. Fighting them. \nBut he can't hold them alone."
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
  - nodeId: 20
    speakerId: PROTAGONIST
    expression: 0
    portraitPosition: 1
    portraitFacing: 0
    text: 'Then he won''t be alone for long.

'
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
  - nodeId: 21
    speakerId: PROTAGONIST
    expression: 0
    portraitPosition: 1
    portraitFacing: 0
    text: 'But the villagers are helpless here.

      I must hold them here first'
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
  - nodeId: 22
    speakerId: PROTAGONIST
    expression: 0
    portraitPosition: 1
    portraitFacing: 0
    text: 'Then help Gajen at the temple.

'
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
  - nodeId: 23
    speakerId: PROTAGONIST
    expression: 0
    portraitPosition: 1
    portraitFacing: 0
    text: "Now go and Hide. \r\nand don't come out until it's quiet. Promise me"
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
  - nodeId: 24
    speakerId: CHILD
    expression: 0
    portraitPosition: 0
    portraitFacing: 1
    text: "\u2026Promise.\n"
    textSpeedOverride: -1
    autoAdvanceDelay: 0
    fullScreenImage: {fileID: 21300000, guid: 34cae94a36041bc4ead0ec77433f86e1, type: 3}
